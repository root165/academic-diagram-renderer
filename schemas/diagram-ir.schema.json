{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic Diagram IR",
  "type": "object",
  "required": ["title", "purpose", "diagram_type", "semantic_level", "notation", "source_requirements"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "diagram_type": {"enum": ["erd", "flowchart", "dfd", "bpmn", "use_case", "sequence", "activity", "state_machine", "structure_chart", "functional_decomposition", "component", "deployment", "table"]},
    "semantic_level": {"type": "string", "minLength": 1},
    "notation": {"type": "string", "minLength": 1},
    "source_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "tbd": {"type": "array", "items": {"type": "string"}},
    "renderer": {"type": "string"},
    "entities": {"type": "array"},
    "relationships": {"type": "array"},
    "nodes": {"type": "array"},
    "edges": {"type": "array"},
    "data_flows": {"type": "array"}
  }
}
